{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@comtouz/domain": ["../../packages/domain/src/index.ts"],
      "@comtouz/graph": ["../../packages/graph/src/index.ts"],
      "@comtouz/cache": ["../../packages/cache/src/index.ts"],
      "@comtouz/security": ["../../packages/security/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}