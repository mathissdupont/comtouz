{
  "name": "comtouz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "npm run dev -w @comtouz/web",
    "lint:web": "npm run lint -w @comtouz/web",
    "typecheck:web": "npm run typecheck -w @comtouz/web"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}